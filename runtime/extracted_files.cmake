# Include after the runtime target and other game-local adaptations exist.
find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
if(NOT PORT_GAME_ROOT AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/../installer.json")
    get_filename_component(PORT_GAME_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/.." ABSOLUTE)
endif()
if(PORT_GAME_ROOT AND EXISTS "${PORT_GAME_ROOT}/game_files" AND EXISTS "${PORT_GAME_ROOT}/installer.json")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/../prepare_folder.py"
        --root "${PORT_GAME_ROOT}" --config "${PORT_GAME_ROOT}/installer.json" COMMAND_ERROR_IS_FATAL ANY)
endif()
get_target_property(_pi_source ps2_runtime SOURCE_DIR)
file(GLOB_RECURSE _pi_inputs CONFIGURE_DEPENDS "${_pi_source}/src/lib/Kernel/Stubs/*")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_pi_inputs}
    "${_pi_source}/src/lib/ps2_iop_host.cpp" "${CMAKE_CURRENT_LIST_DIR}/apply_runtime.py" "${CMAKE_CURRENT_LIST_DIR}/extracted_disc.h")
set(_pi_local "${CMAKE_CURRENT_BINARY_DIR}/extracted-file-runtime")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_LIST_DIR}/apply_runtime.py"
    --source "${_pi_source}" --output "${_pi_local}" COMMAND_ERROR_IS_FATAL ANY)
get_target_property(_pi_sources ps2_runtime SOURCES)
set(_pi_replaced "")
foreach(_pi_item IN LISTS _pi_sources)
    if(_pi_item MATCHES "(^|/)src/lib/Kernel/Stubs/(.*\\.cpp)$")
        set(_pi_name "${CMAKE_MATCH_2}")
        set(_pi_new "${_pi_local}/Stubs/${_pi_name}")
        list(APPEND _pi_replaced "${_pi_new}")
        get_filename_component(_pi_dir "${_pi_source}/src/lib/Kernel/Stubs/${_pi_name}" DIRECTORY)
        set_source_files_properties("${_pi_new}" TARGET_DIRECTORY ps2_runtime PROPERTIES INCLUDE_DIRECTORIES "${_pi_dir}")
    elseif(_pi_item MATCHES "(^|/)src/lib/ps2_iop_host\\.cpp$")
        list(APPEND _pi_replaced "${_pi_local}/ps2_iop_host.cpp")
        set_source_files_properties("${_pi_local}/ps2_iop_host.cpp" TARGET_DIRECTORY ps2_runtime PROPERTIES INCLUDE_DIRECTORIES "${_pi_source}/src/lib")
    else()
        get_filename_component(_pi_leaf "${_pi_item}" NAME)
        string(FIND "${_pi_item}" "${_pi_source}/" _pi_is_shared)
        if(_pi_is_shared LESS 0 AND IS_ABSOLUTE "${_pi_item}" AND EXISTS "${_pi_source}/src/lib/Kernel/Stubs/${_pi_leaf}")
            file(READ "${_pi_item}" _pi_custom_content)
            if(_pi_custom_content MATCHES "namespace ps2_stubs")
            set(_pi_custom "${_pi_local}/Stubs/${_pi_leaf}")
            file(CONFIGURE OUTPUT "${_pi_custom}" CONTENT "${_pi_custom_content}" @ONLY)
            list(APPEND _pi_replaced "${_pi_custom}")
            set_source_files_properties("${_pi_custom}" TARGET_DIRECTORY ps2_runtime PROPERTIES INCLUDE_DIRECTORIES "${_pi_source}/src/lib/Kernel/Stubs")
            else()
                list(APPEND _pi_replaced "${_pi_item}")
            endif()
        else()
            list(APPEND _pi_replaced "${_pi_item}")
        endif()
    endif()
endforeach()
# Other game patches can supply their own stub source copies (e.g. MPEG.cpp).
# Their quoted Common.h include must resolve to the adapted helper implementation too.
target_include_directories(ps2_runtime BEFORE PRIVATE "${_pi_local}/Stubs" "${_pi_local}")
set_property(TARGET ps2_runtime PROPERTY SOURCES ${_pi_replaced})
